# Vision API (pick one - Gemini recommended for free tier)
GEMINI_API_KEY=your_gemini_api_key_here
# or
# GOOGLE_API_KEY=your_google_api_key_here

# Text-to-Speech (pick one - ElevenLabs recommended for quality)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional ElevenLabs settings:
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (default)
# ELEVENLABS_MODEL_ID=eleven_monolingual_v1

# Alternative APIs (fallbacks):
# OPENAI_API_KEY=your_openai_api_key
# GROQ_API_KEY=your_groq_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key

# Local AI (set to 0 to disable local Ollama/Kokoro)
# LOCAL_AI=1
